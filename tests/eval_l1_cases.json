{
  "meta": {
    "name": "L1数值变体对题库",
    "version": "0.1",
    "created": "2026-09-13",
    "design": "E队4c/Yang2025数值变体法：fictional标的+注入数字变体，模型输出必须引用注入数字=真读取推理；复读模板=表面推理。判分器见scripts/run_eval_l1.ts",
    "cost_note": "谷时跑批（00:30-08:30）——单轮全量约0.2元，峰时翻倍",
    "scale_target": "E队口径60题（含20变体对）；本版10类×2对=20对起步"
  },
  "cases": [
    {"id": "L1-PS-01", "type": "variant_pair", "metric": "PS", "template": "虚构标的【{stock}】数据（仅使用下方给定数字，不要用你记忆中的任何真实公司数据）：当前股价{price}美元，年营收{rev}亿美元，股本{shares}亿股。请计算市销率PS（市值/营收）并给一句话估值判断。", "a": {"stock": "澜舟智能", "price": 120, "rev": 40, "shares": 10}, "b": {"stock": "澜舟智能", "price": 210, "rev": 40, "shares": 10}, "expect": {"a_answers": ["3"], "b_answers": ["5.25"], "answer_pattern": "PS.{0,6}(约|等于|为)?\\s*{ans}"}},
    {"id": "L1-PS-02", "type": "variant_pair", "metric": "PS", "template": "虚构标的【{stock}】数据（仅用给定数字）：股价{price}美元，年营收{rev}亿美元，股本{shares}亿股。计算PS并判断与行业均值4倍的相对位置。", "a": {"stock": "北辰数联", "price": 88, "rev": 22, "shares": 4}, "b": {"stock": "北辰数联", "price": 132, "rev": 22, "shares": 4}, "expect": {"a_answers": ["4"], "b_answers": ["6"], "answer_pattern": "PS.{0,6}(约|等于|为)?\\s*{ans}"}},
    {"id": "L1-PE-01", "type": "variant_pair", "metric": "PE", "template": "虚构标的【{stock}】数据（仅用给定数字）：股价{price}美元，每股收益EPS={eps}美元。计算市盈率PE并一句话判断。", "a": {"stock": "昆仑算法", "price": 200, "eps": 8}, "b": {"stock": "昆仑算法", "price": 300, "eps": 8}, "expect": {"a_answers": ["25"], "b_answers": ["37.5"], "answer_pattern": "PE.{0,6}(约|等于|为)?\\s*{ans}"}},
    {"id": "L1-PE-02", "type": "variant_pair", "metric": "PE", "template": "虚构标的【{stock}】数据（仅用给定数字）：股价{price}美元，EPS={eps}美元。计算PE，并判断若要求PE不超过30倍、当前价格隐含的溢价或折价百分比。", "a": {"stock": "天枢医疗", "price": 90, "eps": 6}, "b": {"stock": "天枢医疗", "price": 45, "eps": 6}, "expect": {"a_answers": ["15"], "b_answers": ["7.5"], "answer_pattern": "PE.{0,6}(约|等于|为)?\\s*{ans}"}},
    {"id": "L1-CHG-01", "type": "variant_pair", "metric": "涨跌幅", "template": "虚构标的【{stock}】昨日收盘{prev}美元，今日收盘{close}美元。计算当日涨跌幅百分比。", "a": {"stock": "启元动力", "prev": 100, "close": 112}, "b": {"stock": "启元动力", "prev": 112, "close": 100}, "expect": {"a_answers": ["12"], "b_answers": ["10.7"], "answer_pattern": "{ans}"}},
    {"id": "L1-CHG-02", "type": "variant_pair", "metric": "涨跌幅", "template": "虚构标的【{stock}】昨日收盘{prev}美元，今日收盘{close}美元。计算当日涨跌幅百分比并说明多空含义。", "a": {"stock": "青崖半导", "prev": 80, "close": 60}, "b": {"stock": "青崖半导", "prev": 60, "close": 80}, "expect": {"a_answers": ["25"], "b_answers": ["33.3"], "answer_pattern": "{ans}"}},
    {"id": "L1-MCAP-01", "type": "variant_pair", "metric": "市值", "template": "虚构标的【{stock}】数据（仅用给定数字）：股价{price}美元，总股本{shares}亿股。计算总市值（亿美元）。", "a": {"stock": "九章云图", "price": 45, "shares": 8}, "b": {"stock": "九章云图", "price": 45, "shares": 20}, "expect": {"a_answers": ["360"], "b_answers": ["900"], "answer_pattern": "{ans}\\s*(亿美元|亿)"}},
    {"id": "L1-MCAP-02", "type": "variant_pair", "metric": "市值", "template": "虚构标的【{stock}】数据（仅用给定数字）：股价{price}美元，总股本{shares}亿股。计算总市值（亿美元）并判断是否属于大盘股（以2000亿美元为界）。", "a": {"stock": "瀚海生科", "price": 25, "shares": 30}, "b": {"stock": "瀚海生科", "price": 250, "shares": 30}, "expect": {"a_answers": ["750"], "b_answers": ["7500"], "answer_pattern": "{ans}\\s*(亿美元|亿)"}},
    {"id": "L1-GM-01", "type": "variant_pair", "metric": "毛利率", "template": "虚构标的【{stock}】年营收{rev}亿美元，营业成本{cost}亿美元。计算毛利率百分比。", "a": {"stock": "星桥通信", "rev": 50, "cost": 30}, "b": {"stock": "星桥通信", "rev": 50, "cost": 15}, "expect": {"a_answers": ["40"], "b_answers": ["70"], "answer_pattern": "{ans}"}},
    {"id": "L1-GM-02", "type": "variant_pair", "metric": "毛利率", "template": "虚构标的【{stock}】年营收{rev}亿美元，营业成本{cost}亿美元。计算毛利率并与虚构同行60%毛利率比较高低。", "a": {"stock": "远山智造", "rev": 80, "cost": 56}, "b": {"stock": "远山智造", "rev": 80, "cost": 24}, "expect": {"a_answers": ["30"], "b_answers": ["70"], "answer_pattern": "{ans}"}},
    {"id": "L1-NM-01", "type": "variant_pair", "metric": "净利率", "template": "虚构标的【{stock}】年营收{rev}亿美元，净利润{profit}亿美元。计算净利率百分比。", "a": {"stock": "沧澜软件", "rev": 60, "profit": 9}, "b": {"stock": "沧澜软件", "rev": 60, "profit": 3}, "expect": {"a_answers": ["15"], "b_answers": ["5"], "answer_pattern": "{ans}"}},
    {"id": "L1-NM-02", "type": "variant_pair", "metric": "净利率", "template": "虚构标的【{stock}】年营收{rev}亿美元，净利润{profit}亿美元。计算净利率并对比虚构对手净利率12%的高低。", "a": {"stock": "灵犀医疗", "rev": 30, "profit": 6}, "b": {"stock": "灵犀医疗", "rev": 30, "profit": 2.1}, "expect": {"a_answers": ["20"], "b_answers": ["7"], "answer_pattern": "{ans}"}},
    {"id": "L1-DR-01", "type": "variant_pair", "metric": "负债率", "template": "虚构标的【{stock}】总资产{assets}亿美元，总负债{debt}亿美元。计算资产负债率百分比。", "a": {"stock": "磐石重工", "assets": 100, "debt": 65}, "b": {"stock": "磐石重工", "assets": 100, "debt": 30}, "expect": {"a_answers": ["65"], "b_answers": ["30"], "answer_pattern": "{ans}"}},
    {"id": "L1-DR-02", "type": "variant_pair", "metric": "负债率", "template": "虚构标的【{stock}】总资产{assets}亿美元，总负债{debt}亿美元。计算资产负债率并判断是否高于警戒线70%。", "a": {"stock": "恒岳能源", "assets": 200, "debt": 150}, "b": {"stock": "恒岳能源", "assets": 200, "debt": 80}, "expect": {"a_answers": ["75"], "b_answers": ["40"], "answer_pattern": "{ans}"}},
    {"id": "L1-GR-01", "type": "variant_pair", "metric": "增速", "template": "虚构标的【{stock}】去年营收{prev}亿美元，今年营收{curr}亿美元。计算营收同比增长率百分比（保留一位小数）。", "a": {"stock": "扶摇自动", "prev": 40, "curr": 52}, "b": {"stock": "扶摇自动", "prev": 52, "curr": 40}, "expect": {"a_answers": ["30"], "b_answers": ["23.1"], "answer_pattern": "{ans}"}},
    {"id": "L1-GR-02", "type": "variant_pair", "metric": "增速", "template": "虚构标的【{stock}】去年净利润{prev}亿美元，今年净利润{curr}亿美元。计算净利润同比增速百分比（保留一位小数）。", "a": {"stock": "望舒新能", "prev": 5, "curr": 7.5}, "b": {"stock": "望舒新能", "prev": 7.5, "curr": 5}, "expect": {"a_answers": ["50"], "b_answers": ["33.3"], "answer_pattern": "{ans}"}},
    {"id": "L1-MOS-01", "type": "variant_pair", "metric": "安全边际", "template": "虚构标的【{stock}】你评估的内在价值为{iv}美元/股，当前市价{price}美元。按格雷厄姆口径计算安全边际百分比=(内在价值-市价)/内在价值。", "a": {"stock": "观澜消费", "iv": 100, "price": 70}, "b": {"stock": "观澜消费", "iv": 100, "price": 95}, "expect": {"a_answers": ["30"], "b_answers": ["5"], "answer_pattern": "{ans}"}},
    {"id": "L1-MOS-02", "type": "variant_pair", "metric": "安全边际", "template": "虚构标的【{stock}】内在价值{iv}美元/股，市价{price}美元。计算安全边际百分比并判断是否达到40%的重仓门槛。", "a": {"stock": "临渊科技", "iv": 80, "price": 40}, "b": {"stock": "临渊科技", "iv": 80, "price": 72}, "expect": {"a_answers": ["50"], "b_answers": ["10"], "answer_pattern": "{ans}"}},
    {"id": "L1-POS-01", "type": "variant_pair", "metric": "仓位", "template": "虚构账户总资金{capital}万美元，单笔风险上限{risk}%。按该上限，止损距离{stop}%的股票最多可买入多少万元仓位（仓位=资金×风险%÷止损%）？", "a": {"stock": "逐风量化", "capital": 100, "risk": 2, "stop": 4}, "b": {"stock": "逐风量化", "capital": 100, "risk": 1, "stop": 4}, "expect": {"a_answers": ["50"], "b_answers": ["25"], "answer_pattern": "{ans}\\s*万"}},
    {"id": "L1-POS-02", "type": "variant_pair", "metric": "仓位", "template": "虚构账户总资金{capital}万美元，单笔风险上限{risk}%，止损距离{stop}%。计算最大仓位（万元）。", "a": {"stock": "听潮资管", "capital": 200, "risk": 2, "stop": 8}, "b": {"stock": "听潮资管", "capital": 200, "risk": 2, "stop": 2}, "expect": {"a_answers": ["50"], "b_answers": ["200"], "answer_pattern": "{ans}\\s*万"}}
  ]
}
